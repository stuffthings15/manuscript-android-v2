    <string name="external_access_heading">Use Manuscript in other apps</string>
    <string name="external_access_off">Off. Enable the local writing helper to use the Manuscript icon in supported message, email, document, and browser text fields.</string>
    <string name="external_access_on">On. Manuscript can show its icon beside supported normal text fields. Password fields are ignored.</string>
    <string name="external_access_enable">Enable across apps</string>
    <string name="external_access_settings">Open accessibility settings</string>
    <string name="external_disclosure_title">Allow across-app writing help?</string>
    <string name="external_disclosure_message">Manuscript uses Android Accessibility access to detect the normal text field you are actively editing and checks whether that field contains text so it can show the Manuscript icon. It reads the field only after you tap the Manuscript icon, shows a local review panel over the keyboard area, and uses the active field’s text connection to replace text only after you tap Accept. Text is processed on this device and is not sent to Manuscript servers. Password fields are ignored. After Continue, tap Installed apps, tap Manuscript across-app writing helper, then turn it on. You can turn this access off at any time.</string>
    <string name="external_disclosure_continue">Continue</string>
