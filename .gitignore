/.gradle/
/.kotlin/
/local.properties
/**/build/
/**/.cxx/
*.jks
*.keystore

# Raw device captures can contain private text, account names, or device data.
/evidence/private/
/evidence/*.xml
/evidence/*.png
/evidence/*.jpg
/evidence/*.jpeg
/evidence/*.webp
/test-evidence/**/*.apk
/test-evidence/**/*.stdout.txt
/test-evidence/**/*.stderr.txt
/play/release-contact.properties

# GPT 5.6 device round artifacts are private generated evidence.
/test-evidence/gpt56-five-page-all-tones-v2/*/

# Corpus scratch: pulled essay outputs and substitution dumps for one round.
# Committing a round would let a stale one be read as the current result.
/tools/corpus/work/

# Signed release bundles. Kept on disk for upload, never committed: the
# outer Echo-Link repo already carries 5 GB of these in history and GitHub
# refuses any file over 100 MB.
/releases/
